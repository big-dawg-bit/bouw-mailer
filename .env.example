# Copy this file to .env and fill it in. .env is gitignored - never commit it.

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your full Gmail address, e.g. jouw.naam@gmail.com
SMTP_USER=

# A 16-character Google App Password - NOT your normal account password.
# Requires 2-Step Verification: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=

# --- Sender identity ---
FROM_NAME=
REPLY_TO=

# --- Input / pacing ---
EXCEL_PATH=data/emailaddressen-bouwbedrijven.xlsx
SEND_DELAY_SECONDS=8
